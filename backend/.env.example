APP_NAME=THE PANTHEON
APP_ENV=development
API_CORS_ORIGINS=http://localhost:5174,https://pantheon.kunnankada.in
CLERK_ISSUER=https://fair-panther-4310.clerk.accounts.dev
# Local development: `cd backend && docker compose up -d db`, or point this at
# your own Postgres. Deployed Vercel sets the pooled Neon URL as an environment
# variable in its dashboard; never commit that value to the repo.
DATABASE_URL=postgresql+psycopg://companyos:change-me-before-use@localhost:5433/companyos
# Optional direct connection for migrations/admin jobs (not used by the app).
DATABASE_URL_UNPOOLED=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable and private; it encrypts provider API keys saved in the UI.
# For Render, set the value in the backend service environment and redeploy.
LLM_CONFIG_ENCRYPTION_KEY=

LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=lm-studio
LOCAL_MODEL=qwen2.5-coder-7b-instruct-mlx

CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=your-provider-key
CLOUD_MODEL=gpt-4.1-mini

CEO_PROVIDER=local
CFO_PROVIDER=local
CTO_PROVIDER=local
CSO_PROVIDER=local
BOARD_PROVIDER=local

CEO_MODEL=
CFO_MODEL=
CTO_MODEL=
CSO_MODEL=
BOARD_MODEL=

AGENT_CONCURRENCY=1
PROGRESS_INITIAL_AGENT_SECONDS=60
BOARD_SYNTHESIS_MAX_INPUT_CHARS=6000